import sys
import time
import cv2
from ultralytics import YOLO


def draw_seg(frame, p1, p2):
    if p1 is not None and p2 is not None and p1[0] > 0 and p2[0] > 0:
        cv2.line(
            frame,
            (int(p1[0]), int(p1[1])),
            (int(p2[0]), int(p2[1])),
            (0, 0, 0),
            4,
        )


model = YOLO("yolov8n-pose.pt")

cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)
if not cap.isOpened():
    cap = cv2.VideoCapture(0)

if not cap.isOpened():
    sys.exit()

cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

WINDOW_NAME = "Simplified Pose Tracker"
cv2.namedWindow(WINDOW_NAME, cv2.WINDOW_NORMAL)

prev_time = time.time()

try:
    while True:
        ret, frame = cap.read()
        if not ret or frame is None:
            continue

        frame = cv2.flip(frame, 1)

        results = model(
            frame,
            imgsz=320,
            stream=True,
            verbose=False,
            conf=0.4,
            classes=[0],
        )

        for result in results:
            if result.keypoints is not None and result.keypoints.xy is not None:
                keypoints_data = result.keypoints.xy.cpu().numpy()

                for person in keypoints_data:
                    nose = person[0]
                    l_sh, r_sh = person[5], person[6]
                    l_elb, r_elb = person[7], person[8]
                    l_wri, r_wri = person[9], person[10]
                    l_hip, r_hip = person[11], person[12]
                    l_kne, r_kne = person[13], person[14]
                    l_ank, r_ank = person[15], person[16]

                    if l_sh[0] > 0 and r_sh[0] > 0:
                        mid_sh = (
                            int((l_sh[0] + r_sh[0]) * 0.5),
                            int((l_sh[1] + r_sh[1]) * 0.5),
                        )
                    else:
                        mid_sh = None

                    if mid_sh is not None:
                        draw_seg(frame, mid_sh, nose)
                        draw_seg(frame, mid_sh, l_sh)
                        draw_seg(frame, l_sh, l_elb)
                        draw_seg(frame, l_elb, l_wri)
                        draw_seg(frame, mid_sh, r_sh)
                        draw_seg(frame, r_sh, r_elb)
                        draw_seg(frame, r_elb, r_wri)
                        draw_seg(frame, mid_sh, l_hip)
                        draw_seg(frame, mid_sh, r_hip)
                        draw_seg(frame, l_hip, r_hip)

                    draw_seg(frame, l_hip, l_kne)
                    draw_seg(frame, l_kne, l_ank)
                    draw_seg(frame, r_hip, r_kne)
                    draw_seg(frame, r_kne, r_ank)

                    if nose[0] > 0 and nose[1] > 0:
                        cv2.circle(
                            frame, (int(nose[0]), int(nose[1])), 6, (0, 0, 0), 2
                        )
                        cv2.circle(
                            frame,
                            (int(nose[0]), int(nose[1])),
                            3,
                            (255, 255, 255),
                            -1,
                        )

                    blue_pts = [
                        mid_sh,
                        l_sh,
                        r_sh,
                        l_elb,
                        r_elb,
                        l_wri,
                        r_wri,
                        l_kne,
                        r_kne,
                        l_ank,
                        r_ank,
                    ]
                    for pt in blue_pts:
                        if pt is not None and pt[0] > 0 and pt[1] > 0:
                            cv2.circle(
                                frame, (int(pt[0]), int(pt[1])), 5, (255, 0, 0), -1
                            )

                    for hip in (l_hip, r_hip):
                        if hip[0] > 0 and hip[1] > 0:
                            cv2.circle(
                                frame,
                                (int(hip[0]), int(hip[1])),
                                5,
                                (0, 0, 255),
                                -1,
                            )
                            cv2.circle(
                                frame,
                                (int(hip[0]), int(hip[1])),
                                3,
                                (0, 255, 255),
                                -1,
                            )

        curr_time = time.time()
        fps = (
            int(1.0 / (curr_time - prev_time))
            if (curr_time - prev_time) > 0
            else 0
        )
        prev_time = curr_time

        cv2.putText(
            frame,
            f"FPS: {fps}",
            (20, 35),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (0, 255, 0),
            2,
        )
        cv2.imshow(WINDOW_NAME, frame)

        if cv2.waitKey(1) & 0xFF == ord("q"):
            break
finally:
    cap.release()
    cv2.destroyAllWindows()
